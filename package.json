{
  "name": "@faultscope/node",
  "version": "1.1.0",
  "description": "Universal FaultScope SDK for Node.js, Express, Fastify, Koa, NestJS, Next.js, Nuxt, React, Vue and more.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "require": "./dist/fastify.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.mjs",
      "require": "./dist/koa.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.mjs",
      "require": "./dist/nestjs.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.mjs",
      "require": "./dist/nextjs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/express.ts src/fastify.ts src/koa.ts src/nestjs.ts src/nextjs.ts src/react.ts src/vue.ts src/nuxt.ts --format cjs,esm --dts --minify",
    "dev": "tsup src/index.ts src/browser.ts src/express.ts src/fastify.ts src/koa.ts src/nestjs.ts src/nextjs.ts src/react.ts src/vue.ts src/nuxt.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "faultscope", "exception-tracking", "error-monitoring",
    "nodejs", "express", "fastify", "koa", "nestjs",
    "nextjs", "nuxt", "react", "vue", "typescript"
  ],
  "author": "FaultScope",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaultScope-Exception-Tracking/node-sdk.git"
  },
  "homepage": "https://github.com/FaultScope-Exception-Tracking/node-sdk#readme",
  "bugs": {
    "url": "https://github.com/FaultScope-Exception-Tracking/node-sdk/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=16"
  }
}
